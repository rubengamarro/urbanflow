URBANFLOW_ROOT=.
# Local use is file-backed. Set this to enable transactional PostgreSQL loading.
# DATABASE_URL=postgresql+psycopg://urbanflow:urbanflow@localhost:5432/urbanflow
# MLFLOW_TRACKING_URI=http://localhost:5000
URBANFLOW_API_URL=http://localhost:8000
PREFECT_SERVER_ANALYTICS_ENABLED=false
# External Docker API port; use 18000 when Windows reserves port 8000.
URBANFLOW_API_PORT=8000
